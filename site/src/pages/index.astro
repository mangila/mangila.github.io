---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import heroImage from "../assets/hero.jpeg";
import { GITHUB_USERNAME, NAME } from "../shared/utils";
import {
  getGitHubReadmeAsync,
  convertMarkdownToHtmlAsync,
} from "../shared/github";

const readme = await getGitHubReadmeAsync(GITHUB_USERNAME, GITHUB_USERNAME);
const markdownHtml = await convertMarkdownToHtmlAsync(readme.content);
---

<Layout>
  <div class="flex w-full justify-center">
    <div class="hero bg-base-200 min-h-[50vh]">
      <div class="hero-content flex-col items-center gap-8 lg:flex-row-reverse">
        <figure class="w-full max-w-md">
          <Image
            src={heroImage}
            alt={NAME}
            priority
            format="webp"
            quality="mid"
            class="h-auto w-full rounded-lg object-cover shadow-2xl"
          />
        </figure>
        <div class="prose prose-md max-w-none">
          <Fragment set:html={markdownHtml} />
        </div>
      </div>
    </div>
  </div>
</Layout>
