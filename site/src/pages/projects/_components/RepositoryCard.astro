---
import type { GithubRepositoryResponse } from "../../../shared/github.ts";

import { getLanguageBadgeBgColor } from "../../../shared/utils";

interface Props {
  repository: GithubRepositoryResponse;
}
const { repository } = Astro.props;

const languageBadgeBgColor = getLanguageBadgeBgColor(repository.language);
---

<a
  href={repository.html_url}
  target="_blank"
  rel="noopener noreferrer"
  class="link link-hover m-2 block h-full"
>
  <div class="rounded-box flex h-full flex-col justify-between border-2 p-2">
    <div>
      <span class="block text-lg font-bold">
        {repository.name}
      </span>

      {
        repository.description && (
          <p class="text-base-content/70 mt-1 text-sm">
            {repository.description}
          </p>
        )
      }
    </div>

    <div class="mt-4 flex items-center gap-3 text-sm font-medium">
      <span class="flex items-center gap-1">
        <span aria-hidden="true">⭐</span>
        {repository.stargazers_count}
      </span>

      {
        repository.language && (
          <span class="flex items-center gap-1.5">
            <span
              class={`h-3 w-3 rounded-full ${getLanguageBadgeBgColor(repository.language)}`}
              aria-hidden="true"
            />
            <span>{repository.language}</span>
          </span>
        )
      }

      {
        repository.archived && (
          <div class="badge badge-warning badge-sm">Archived</div>
        )
      }
    </div>
  </div>
</a>
