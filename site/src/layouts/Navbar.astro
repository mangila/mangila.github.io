---
import ThemeSwap from "../components/ThemeSwap.astro";
import { Icon } from "astro-icon/components";
import { NAME } from "../shared/utils";
---

<nav>
  <div class="navbar bg-base-300 shadow-sm">
    <a href="/" class="flex-1">
      <div class="flex items-center gap-2">
        <Icon
          name="codicon:code"
          class="h-10 w-10 fill-current"
          aria-hidden="true"
        />
        <span class="prose prose-xl font-bold">{NAME}</span>
      </div>
    </a>

    <div class="mr-4 flex-none">
      <a
        href="https://github.com/mangila/mangila.github.io"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block border-b border-transparent text-inherit no-underline hover:border-current"
      >
        <Icon
          name="codicon:github"
          class="h-10 w-10 fill-current"
          aria-hidden="true"
        />
        <span class="sr-only">Visit this website GitHub Repository</span>
      </a>
    </div>

    <div class="m-2 flex-none">
      <ThemeSwap />
    </div>
  </div>
</nav>
