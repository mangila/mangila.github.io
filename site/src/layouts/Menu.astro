---
const { pathname } = Astro.url;
---

<div id="navigation-menu" class="row prose-xl mt-4 flex justify-center gap-4">
  <a class="link link-hover" href="/" aria-label="Go to Home page">
    <span class={`${pathname === "/" ? "underline" : ""}`}>Home</span>
  </a>
  <a class="link link-hover" href="/projects" aria-label="Go to Projects page">
    <span class={`${pathname === "/projects" ? "underline" : ""}`}
      >Projects</span
    >
  </a>
  <a class="link link-hover" href="/guides" aria-label="Go to Guides page">
    <span class={`${pathname === "/guides" ? "underline" : ""}`}>Guides</span>
  </a>
</div>
