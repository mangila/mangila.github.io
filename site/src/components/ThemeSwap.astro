---
import { Icon } from "astro-icon/components";
---

<label class="flex cursor-pointer gap-2">
  <Icon id="sunny" name="ion:sunny-outline" class="h-6 w-6" />
  <input
    id="theme-slider"
    type="checkbox"
    value="dark"
    class="toggle theme-controller"
  />
  <Icon id="moon" name="ion:moon-outline" class="h-6 w-6" />
</label>

<script>
  const themeSlider = document.getElementById(
    "theme-slider",
  ) as HTMLInputElement;
  const currentTheme = document.documentElement.getAttribute("data-theme");

  if (themeSlider) {
    themeSlider.checked = currentTheme === "dark";
    themeSlider.addEventListener("change", (e) => {
      const target = e.target as HTMLInputElement;
      const newTheme = target.checked ? "dark" : "light";
      localStorage.setItem("theme", newTheme);
    });
  }
</script>
